# Copy to .env and fill in what you need. Every value here is optional:
# without an API key the app runs on the reference template planner.

# ---------------------------------------------------------------------------
# AI planner
# ---------------------------------------------------------------------------
# Get a key at https://console.anthropic.com/. Either name works.
ANTHROPIC_API_KEY=

# Model and reasoning depth. Opus 5.5 is the default; effort trades cost
# against day-sequencing quality (low | medium | high | xhigh | max).
WTN_ANTHROPIC_MODEL=claude-opus-5-5
WTN_EFFORT=high
WTN_MAX_TOKENS=32000
WTN_REQUEST_TIMEOUT_SECONDS=240
WTN_MAX_RETRIES=2

# Serve a template plan when the model call fails, instead of an error.
WTN_FALLBACK_TO_HEURISTIC=true

# Force the template planner even when a key is present (useful for demos).
WTN_FORCE_HEURISTIC=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
WTN_ENVIRONMENT=dev
WTN_LOG_LEVEL=INFO
WTN_CORS_ORIGINS=*
WTN_DATABASE_URL=sqlite+aiosqlite:///./wheretonext.db

# Plan generations allowed per client IP per minute.
WTN_RATE_LIMIT_PER_MINUTE=10

# How long an identical brief is served from the in-process cache.
WTN_CACHE_TTL_SECONDS=900
WTN_CACHE_MAX_ENTRIES=256

# ---------------------------------------------------------------------------
# Reference data
# ---------------------------------------------------------------------------
# Indicative INR-per-unit FX overrides, as a JSON object. Replace with a live
# feed in production.
# WTN_FX_RATES={"USD": 88.0, "EUR": 95.0}
